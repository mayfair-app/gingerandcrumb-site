---
permalink: /index.html
---
{%- set s = settings -%}
{%- set loc = s.city ~ ", " ~ s.province -%}
{%- set nextWeek = null -%}
{%- for w in weeks -%}{%- if not nextWeek and w.spots_left > 0 -%}{%- set nextWeek = w -%}{%- endif -%}{%- endfor -%}
<!DOCTYPE html>
<html lang="en-CA">
<head>
{% include "seo.njk" %}
<link rel="icon" type="image/png" href="{{ s.favicon or 'images/favicon.png' }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Gloock&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
{% include "styles.njk" %}
</style>
</head>
<body>

{% if s.announcement.show %}<div class="announce">{{ s.announcement.text }} · <a href="#order">{{ s.announcement.link_text }}</a></div>{% endif %}

<nav class="nav" aria-label="Main">
  <div class="wrap">
    <a class="logo" href="#top"><img src="{{ s.logo }}" alt="" width="46" height="46">{{ s.business_name }}</a>
    <ul>
      {% if giveaway.promote %}<li><a class="nav-gw" href="/giveaway/">Giveaway</a></li>{% endif %}
      <li><a href="#menu">Menu</a></li>
      {% if testimonials.show %}<li><a href="#reviews">Reviews</a></li>{% endif %}
      <li><a href="#request">Special requests</a></li>
      {% if availability.show %}<li><a href="#availability">Availability</a></li>{% endif %}
      {% if holiday.show %}<li><a href="#special">{{ holiday.title | replace("The ", "") }}</a></li>{% endif %}
      <li><a href="#faq">FAQ</a></li>
    </ul>
    <a class="btn" href="#order">Order now</a>
  </div>
</nav>

{% if giveaway.promote %}
<a class="gw-strip" href="/giveaway/">
  <span class="gw-strip-k">♥ Giveaway ♥</span>
  <span class="gw-strip-t">{{ giveaway.title }}</span>
  <span class="gw-strip-s">{{ giveaway.winners }} winners · Everyone wins something</span>
  <span class="btn gw-strip-b">Enter now</span>
</a>
{% endif %}

<header class="hero gingham" id="top">
  <div class="wrap">
    <div class="paper scallop label">
      <div class="label-art">{% if s.logo %}<img src="{{ s.logo }}" alt="{{ s.business_name }} logo">{% elif s.hero_photo %}<img src="{{ s.hero_photo }}" alt="Fresh bakes from {{ s.business_name }}">{% else %}<svg viewBox="0 0 100 100" aria-hidden="true">{{ icons.cake | safe }}</svg>{% endif %}</div>
      <span class="tag">Home bakery · {{ loc }}</span>
      <h1>{{ s.hero_headline }} <em>{{ s.hero_highlight }}</em></h1>
      <p>{{ s.hero_intro }}</p>
      <div class="ctas"><a class="btn" href="#order">Book your spot</a><a class="btn soft" href="#menu">See the menu</a></div>
      {% if availability.show and nextWeek %}<div class="booking"><span class="heart" aria-hidden="true">♥</span>Now booking {{ nextWeek.label }}{% if nextWeek.spots_left <= (nextWeek.spots_total / 2) %} · only {{ nextWeek.spots_left }} left{% endif %}</div>{% endif %}
      <ul class="ribbon">{% for b in s.hero_badges %}<li>{{ b }}</li>{% endfor %}</ul>
    </div>
  </div>
</header>

{% if s.trust_items and s.trust_items.length %}
<section class="trust" aria-label="Why Ginger &amp; Crumb" style="padding:0">
  <ul>{% for it in s.trust_items %}<li><svg viewBox="0 0 100 100" aria-hidden="true">{{ icons[it.icon or "heart"] | safe }}</svg>{{ it.text }}</li>{% endfor %}</ul>
</section>
{% endif %}

<section class="about" aria-label="About" style="padding-top:60px">
  <div class="wrap"><div class="paper sheet">
    <p>Hi, I'm <b>{{ s.baker_name }}</b>, the baker behind {{ s.business_name }}. {{ s.about }}</p>
    <span class="sig">xo, {{ s.baker_name }}</span>
  </div></div>
</section>

<section id="menu">
  <div class="wrap"><div class="paper scallop sheet">
    <div class="title"><span class="k">Fresh from the oven</span><h2>The Menu</h2><p>{{ s.menu_intro }}</p></div>
    <div class="menu-cols">
      {% for g in menu.groups %}
      <div class="menu-col">
        <h3>{{ g.title }}</h3>
        {% for it in g.items %}
        <div class="dish{% if not it.available %} off{% endif %}">
          <span class="ic gingham">{% if it.photo %}<img src="{{ it.photo }}" alt="{{ it.name }}" loading="lazy">{% else %}<svg viewBox="0 0 100 100" aria-hidden="true">{{ icons[it.icon or "cookie"] | safe }}</svg>{% endif %}</span>
          <div><h4>{{ it.name }}{% if not it.available %}<span class="off-tag">Not available</span>{% endif %}</h4><span class="price">{{ it.price }}</span><p>{{ it.description }}</p></div>
        </div>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
    <p class="note">{{ s.menu_note }}</p>
  </div></div>
</section>

{% if testimonials.show %}
<section id="reviews">
  <div class="wrap"><div class="paper sheet">
    <div class="title"><span class="k">Reviews</span><h2>{{ testimonials.title }}</h2>{% if testimonials.intro %}<p>{{ testimonials.intro }}</p>{% endif %}</div>
    {% if testimonials.items.length %}
    {%- set feat = testimonials.featured or 6 -%}
    <div class="quotes">
      {% for q in testimonials.items %}{% if loop.index <= feat %}{% include "quote.njk" %}{% endif %}{% endfor %}
    </div>
    {% if testimonials.items.length > feat %}
    <details class="more-reviews">
      <summary>Read {{ testimonials.items.length - feat }} more reviews</summary>
      <div class="quotes">
        {% for q in testimonials.items %}{% if loop.index > feat %}{% include "quote.njk" %}{% endif %}{% endfor %}
      </div>
    </details>
    {% endif %}
    {% else %}
    <div class="first-review">
      <svg viewBox="0 0 100 100" aria-hidden="true">{{ icons.heart | safe }}</svg>
      <div>
        <h3>Be one of our first reviews!</h3>
        <p>Ginger &amp; Crumb is brand new, and every kind word means the world to a small bakery. Tried our cookies? I'd love to hear what you thought, and your review could be featured right here.</p>
        <div class="ctas" style="justify-content:flex-start">{% if s.email %}<a class="btn" href="mailto:{{ s.email }}?subject=My%20Ginger%20%26%20Crumb%20review">Email your review</a>{% endif %}<a class="btn soft" href="https://www.instagram.com/{{ s.instagram }}/">DM us on Instagram</a></div>
      </div>
    </div>
    {% endif %}
    </div>
  </div></div>
</section>
{% endif %}

<section id="request">
  <div class="wrap"><div class="paper sheet">
    <div class="title"><span class="k">Special requests</span><h2>{{ s.request_title or "Craving something not on the menu?" }}</h2><p>{{ s.request_intro }}</p></div>
    <div class="request-grid">
      <div class="request-side">
        <h3>Ideas I love making</h3>
        <ul>
          <li>Family recipes and nonna's favourites</li>
          <li>Regional Italian cookies and pastries</li>
          <li>Mixed cookie trays for weddings, showers and holidays</li>
          <li>Gluten-free or egg-free versions, when possible</li>
        </ul>
        <p style="margin:14px 0 0;font-size:.92rem;color:var(--muted)">Please send requests at least {{ s.lead_time_custom }} before you need them.</p>
      </div>
      <form class="request-form" action="https://formspree.io/f/{{ s.formspree_id }}" method="POST">
        <input type="hidden" name="_subject" value="New special request: {{ s.business_name }}">
        <input type="hidden" name="Request type" value="Special dessert request">
        <div class="field"><label for="r-name">Full name</label><input id="r-name" name="Name" type="text" autocomplete="name" required></div>
        <div class="field"><label for="r-phone">Phone number</label><input id="r-phone" name="Phone" type="tel" autocomplete="tel" required></div>
        <div class="field full"><label for="r-email">Email</label><input id="r-email" name="email" type="email" autocomplete="email" required></div>
        <div class="field full"><label for="r-dessert">What dessert would you like?</label><input id="r-dessert" name="Requested dessert" type="text" placeholder="e.g. sfogliatelle, cannoli, a family recipe" required></div>
        <div class="field"><label for="r-qty">How many / how many guests?</label><input id="r-qty" name="Quantity or guests" type="text" placeholder="e.g. 3 dozen, 40 guests" required></div>
        <div class="field"><label for="r-date">Date needed</label><input id="r-date" name="Date needed" type="date" required></div>
        <div class="field full"><label for="r-details">Details <span class="hint">(flavours, occasion, allergies, budget, or a link to a photo or recipe)</span></label><textarea id="r-details" name="Request details"></textarea></div>
        <div class="submit-row"><button class="btn" type="submit">Send my request</button><p>I'll reply within 48 hours{% if s.email %}, or email <a href="mailto:{{ s.email }}">{{ s.email }}</a>{% endif %}.</p></div>
      </form>
    </div>
  </div></div>
</section>

{% if availability.show %}
<section id="availability">
  <div class="wrap"><div class="paper sheet">
    <div class="title"><span class="k">Limited spots</span><h2>This month's availability</h2><p>One baker, a limited number of orders each week. When a week is full, it's closed.</p></div>
    <div class="weeks">
      {% for w in weeks %}
      {%- set cls = "full" if w.spots_left <= 0 else ("few" if w.spots_left <= (w.spots_total / 2) else "open") -%}
      {%- set booked = ((w.spots_total - w.spots_left) / w.spots_total * 100) | round if w.spots_total > 0 else 100 -%}
      <div class="week {{ cls }}"><div class="d">{{ w.label }}</div><span class="st">{% if cls == "full" %}Fully booked{% elif cls == "few" %}Only {{ w.spots_left }} left!{% else %}Booking now{% endif %}</span><div class="meter"><i style="--w:{{ booked }}%"></i></div><small>{{ w.spots_left if w.spots_left > 0 else 0 }} of {{ w.spots_total }} spots left</small></div>
      {% endfor %}
    </div>
    {% if deadlines.show and deadlines.items.length %}
    <ul class="dl" aria-label="Order deadlines">{% for d in deadlines.items %}<li><b>{{ d.date }}</b> · {{ d.text }}</li>{% endfor %}</ul>
    {% endif %}
  </div></div>
</section>
{% endif %}

{% if holiday.show %}
<section id="special">
  <div class="wrap">
    <div class="special gingham"><div class="special-in">
      <div class="special-art gingham">{% if holiday.photo %}<img src="{{ holiday.photo }}" alt="{{ holiday.title }}">{% else %}<svg viewBox="0 0 100 100" aria-hidden="true">{{ icons[holiday.icon or "box"] | safe }}</svg>{% endif %}</div>
      <div>
        <span class="k">{{ holiday.kicker }}</span>
        <h2>{{ holiday.title }}</h2>
        <ul>{% for d in holiday.details %}<li>{{ d }}</li>{% endfor %}<li>Only {{ holiday.total }} available</li></ul>
        {% if holiday.total > 0 %}{%- set pct = (holiday.claimed / holiday.total * 100) | round -%}
        <div class="meter"><i style="--w:{{ pct }}%"></i></div>
        <p class="count">{% if holiday.claimed >= holiday.total %}Sold out. Thank you!{% else %}{{ holiday.claimed }} of {{ holiday.total }} claimed{% endif %}</p>{% endif %}
        {% if holiday.claimed < holiday.total %}<a class="btn" href="#order">Reserve yours · {{ holiday.price }}</a>{% endif %}
      </div>
    </div></div>
  </div>
</section>
{% endif %}

<section id="how">
  <div class="wrap"><div class="paper sheet">
    <div class="title"><span class="k">Easy as pie</span><h2>How ordering works</h2></div>
    <ol class="steps">
      <li><h3>Send your order</h3><p>Fill out the form below with what you'd like and your pickup date.</p></li>
      <li><h3>I'll confirm</h3><p>Within 24 hours I'll text you to confirm details and your total.</p></li>
      <li><h3>Pay to book</h3><p>Interac e-Transfer: 50% deposit for custom orders, full payment for everything else.</p></li>
      <li><h3>Pick it up</h3><p>Pickup in {{ s.city }}. The address is sent once you're booked.</p></li>
    </ol>
  </div></div>
</section>

<section id="order">
  <div class="wrap"><div class="paper scallop sheet">
    <div class="title"><span class="k">Order form</span><h2>Place your order</h2></div>
    <p class="lead">Order at least <b>{{ s.lead_time_regular }}</b> ahead for cookies and loaves, and <b>{{ s.lead_time_custom }}</b> ahead for custom orders and cookie trays. Your order is booked once I confirm it and payment is received.</p>
    {% if availability.show %}<p class="cap-note"><span aria-hidden="true">♥</span><span>I take about <b>{{ availability.orders_per_week }} orders a week</b>, first-come, first-served. <a href="#availability">Check availability</a> before picking a date.</span></p>{% endif %}
{% include "order-form.njk" %}
  </div></div>
</section>

<section id="faq">
  <div class="wrap"><div class="paper sheet">
    <div class="title"><span class="k">Good to know</span><h2>Questions</h2></div>
    <div class="faq">{% for f in faq.questions %}<details><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>{% endfor %}</div>
  </div></div>
</section>

<div class="foot-ging" aria-hidden="true"></div>
<footer>
  <div class="wrap">
    <a class="logo" href="#top" style="justify-content:center"><img src="{{ s.logo }}" alt="" width="46" height="46">{{ s.business_name }}</a>
    <p>Small-batch home bakery in {{ loc }} · Serving {{ s.service_areas | join(", ") }}</p>
    <div class="cols"><a href="#order">Order form</a>{% if s.email %}<a href="mailto:{{ s.email }}">{{ s.email }}</a>{% endif %}<span>Pickup only · {{ s.city }}, ON</span><a href="https://www.instagram.com/{{ s.instagram }}/">@{{ s.instagram }}</a></div>
    <p style="margin-top:16px;font-size:.82rem">© {{ build.year }} {{ s.business_name }}</p>
  </div>
</footer>
</body>
</html>

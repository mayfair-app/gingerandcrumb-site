/* ===== Animated edition: CSS only, no JavaScript. Content is plain HTML; motion is an extra layer. ===== */

/* Polish that applies everywhere */
.paper{box-shadow:0 1px 0 rgba(91,53,32,.04),0 18px 50px -12px rgba(91,53,32,.18)}
.title .k,.special .k{letter-spacing:.24em}
.title h2{letter-spacing:-.01em}
.btn{transition:transform .25s cubic-bezier(.2,.8,.2,1),box-shadow .25s,background .25s,color .25s}
.btn:hover{transform:translateY(-2px)}
.dish{transition:transform .35s cubic-bezier(.2,.8,.2,1),background .35s;border-radius:12px;padding-left:8px;padding-right:8px;margin:0 -8px}
.dish:hover{transform:translateX(6px);background:var(--pink-soft)}
.dish .ic{transition:transform .5s cubic-bezier(.2,.8,.2,1)}
.dish:hover .ic{transform:rotate(-12deg) scale(1.08)}
.quote{transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s}
.quote:hover{transform:translateY(-6px) rotate(-.4deg)}
.week{transition:transform .35s cubic-bezier(.2,.8,.2,1)}
.week:hover{transform:translateY(-4px)}

/* Title underline: a hand-drawn coral swash under each section heading */
.title .k{display:block}
.title h2{display:inline-block;background:linear-gradient(var(--coral),var(--coral)) no-repeat 50% 100%/var(--u,60%) 4px;padding-bottom:10px;border-radius:2px}

/* Scroll progress bar */
.progress{position:fixed;top:0;left:0;right:0;height:4px;z-index:20;background:linear-gradient(90deg,var(--coral),var(--cross));transform-origin:0 50%;transform:scaleX(0);pointer-events:none}

/* Cookie marquee */
.marquee{overflow:hidden;background:var(--ink);color:#fff;padding:16px 0;border-top:3px solid var(--pink);border-bottom:3px solid var(--pink)}
.marquee-track{display:flex;width:max-content;animation:marquee 110s linear infinite}
.marquee ul{display:flex;list-style:none;margin:0;padding:0}
.marquee li{font-family:var(--display);font-size:clamp(1.3rem,3vw,1.9rem);white-space:nowrap;padding:0 22px;display:flex;align-items:center;gap:44px}
.marquee li::after{content:"♥";color:var(--cross);font-family:var(--body);font-size:.9rem}
.marquee:hover .marquee-track{animation-play-state:paused}
@keyframes marquee{to{transform:translateX(-50%)}}

/* Hero entrance on page load */
@keyframes rise{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:none}}
@keyframes pop{from{opacity:0;transform:scale(.6) rotate(-18deg)}to{opacity:1;transform:none}}
@keyframes float{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-8px) rotate(3deg)}}
@media (prefers-reduced-motion:no-preference){
  .hero .label,.hero2 .label{animation:rise 1s cubic-bezier(.2,.8,.2,1) both}
  .hero .label-art,.hero2 .label-art{animation:pop .9s .25s cubic-bezier(.3,1.4,.4,1) both,float 6s 1.4s ease-in-out infinite}
  .hero .tag,.hero2 .tag{animation:rise .8s .45s cubic-bezier(.2,.8,.2,1) both}
  .hero h1,.hero2 h1{animation:rise .9s .55s cubic-bezier(.2,.8,.2,1) both}
  .hero .label p,.hero2 .label p{animation:rise .9s .7s cubic-bezier(.2,.8,.2,1) both}
  .hero .ctas,.hero2 .ctas{animation:rise .9s .85s cubic-bezier(.2,.8,.2,1) both}
  .hero .booking,.hero .ribbon,.hero2 .booking,.hero2 .ribbon{animation:rise .9s 1s cubic-bezier(.2,.8,.2,1) both}
}
@media (prefers-reduced-motion:reduce){.marquee-track{animation:none}}

/* Scroll-driven motion (Chrome, Edge, Safari 26+). Other browsers simply show everything, unanimated. */
@supports (animation-timeline:view()){
  @media (prefers-reduced-motion:no-preference){
    @keyframes grow{to{transform:scaleX(1)}}
    .progress{animation:grow linear both;animation-timeline:scroll(root)}

    @keyframes navshrink{to{box-shadow:0 10px 30px -10px rgba(91,53,32,.25);border-bottom-color:var(--cross)}}
    .nav{animation:navshrink linear both;animation-timeline:scroll(root);animation-range:0 160px}

    @keyframes parallax{to{background-position:0 -220px}}
    .hero{animation:parallax linear both;animation-timeline:view();animation-range:exit 0% exit 100%}

    @keyframes reveal{from{opacity:0;transform:translateY(60px) scale(.97)}to{opacity:1;transform:none}}
    .about .paper,#menu .paper,#reviews .paper,#request .paper,#availability .paper,#how .paper,#order .paper,#faq .paper,.special{animation:reveal linear both;animation-timeline:view();animation-range:entry 0% entry 45%}

    @keyframes underline{from{--u:0%}to{--u:60%}}
    .title h2{animation:underline linear both;animation-timeline:view();animation-range:entry 40% cover 35%}

    @keyframes slidein{from{opacity:0;transform:translateX(-40px)}to{opacity:1;transform:none}}
    .dish{animation:slidein linear both;animation-timeline:view();animation-range:entry 0% entry 80%}
    .menu-col:nth-child(even) .dish{animation-name:slideright}
    @keyframes slideright{from{opacity:0;transform:translateX(40px)}to{opacity:1;transform:none}}

    @keyframes tilt{from{opacity:0;transform:translateY(50px) rotate(-3deg)}to{opacity:1;transform:none}}
    .quote{animation:tilt linear both;animation-timeline:view();animation-range:entry 0% entry 70%}
    .quote:nth-child(even){animation-name:tilt2}
    @keyframes tilt2{from{opacity:0;transform:translateY(50px) rotate(3deg)}to{opacity:1;transform:none}}

    @keyframes fill{from{width:0}}
    .meter i{animation:fill linear both;animation-timeline:view();animation-range:entry 20% cover 40%}

    @keyframes stamp{from{opacity:0;transform:scale(.4) rotate(-30deg)}60%{opacity:1;transform:scale(1.12) rotate(6deg)}to{transform:none}}
    .steps li::before{animation:stamp linear both;animation-timeline:view();animation-range:entry 10% cover 30%}
    .steps li{animation:reveal linear both;animation-timeline:view();animation-range:entry 0% entry 60%}

    @keyframes spin{from{transform:rotate(-25deg) scale(.85)}to{transform:rotate(12deg) scale(1)}}
    .special-art{animation:spin linear both;animation-timeline:view();animation-range:entry 0% exit 30%}

    @keyframes trustin{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
    .trust li{animation:trustin linear both;animation-timeline:view();animation-range:entry 0% entry 90%}
    .trust li:nth-child(2){animation-range:entry 10% entry 100%}
    .trust li:nth-child(3){animation-range:entry 20% cover 20%}
    .trust li:nth-child(4){animation-range:entry 30% cover 30%}

    @keyframes faqin{from{opacity:0;transform:translateX(-24px)}to{opacity:1;transform:none}}
    .faq details{animation:faqin linear both;animation-timeline:view();animation-range:entry 0% entry 80%}
  }
}
@property --u{syntax:"<percentage>";inherits:false;initial-value:60%}

/* ===== Version 2: photo-led layout (inspired by high-end bakery sites) ===== */
:root{--cream:#fff8f4}
/* Hero: label card + arched photo */
.hero2{padding:clamp(40px,7vw,90px) 0 clamp(50px,7vw,90px);overflow:hidden}
.hero2-in{max-width:1180px;margin:0 auto;padding:0 20px;display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(24px,4vw,60px);align-items:center}
.hero2 .label{margin:0;max-width:none}
.hero2 .label-art{width:150px;height:150px;margin:-100px auto 6px}
.hero2 .label h1{font-size:clamp(2.6rem,6vw,4.8rem)}
.hero2-photo{position:relative}
.arch{border-radius:999px 999px 28px 28px;overflow:hidden;aspect-ratio:4/5;border:10px solid #fff;box-shadow:0 30px 70px -20px rgba(91,53,32,.45)}
.arch img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.04)}
.sticker{position:absolute;width:clamp(110px,14vw,170px);left:-40px;bottom:40px;filter:drop-shadow(0 10px 20px rgba(91,53,32,.25));animation:sway 9s ease-in-out infinite}
@keyframes sway{0%,100%{transform:rotate(-7deg)}50%{transform:rotate(7deg)}}
@media (max-width:860px){.hero2-in{grid-template-columns:1fr}.hero2-photo{order:-1;max-width:420px;margin:0 auto;width:100%}.sticker{left:-10px;bottom:10px}.hero2 .label-art{display:none}.hero2 .label{padding-top:34px}}

/* Featured trio */
.featured{padding:clamp(60px,8vw,110px) 0 30px}
.feat-head{text-align:center;margin-bottom:34px}
.feat-head .k,.celebrate .k{font-weight:800;font-size:.8rem;letter-spacing:.24em;text-transform:uppercase;color:var(--coral)}
.feat-head h2{font-size:clamp(2.4rem,6vw,4rem);margin-top:6px;background:#fff;display:inline-block;padding:4px 22px;border-radius:14px}
.feat-head .k{display:block}
.feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(14px,2.4vw,28px)}
.feat{display:block;text-decoration:none;color:var(--ink);background:#fff;border-radius:26px;overflow:hidden;box-shadow:0 18px 50px -18px rgba(91,53,32,.35);transition:transform .45s cubic-bezier(.2,.8,.2,1),box-shadow .45s}
.feat:hover{transform:translateY(-10px);box-shadow:0 30px 60px -20px rgba(91,53,32,.45)}
.feat-img{display:block;aspect-ratio:4/5;overflow:hidden}
.feat-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 1.2s cubic-bezier(.2,.8,.2,1)}
.feat:hover .feat-img img{transform:scale(1.08)}
.feat-body{display:flex;flex-direction:column;gap:4px;padding:20px 22px 24px}
.feat-body b{font-family:var(--display);font-weight:400;font-size:1.6rem;line-height:1.1}
.feat-body span{color:var(--muted)}
.feat-tag{align-self:flex-start;background:var(--pink-soft);color:var(--coral)!important;font-weight:800;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;border-radius:999px;padding:4px 12px}
.feat-cta{color:var(--coral)!important;font-weight:800;margin-top:8px}
@media (max-width:760px){.feat-grid{grid-template-columns:1fr;max-width:420px;margin:0 auto}.feat-img{aspect-ratio:4/3}}

/* Photo strip, two rows drifting opposite ways */
.strip{padding:clamp(50px,7vw,90px) 0;overflow:hidden;background:var(--ink)}
.strip-title{color:#fff;text-align:center;font-size:clamp(2.2rem,6vw,4.4rem);margin:0 20px 34px}
.strip-title em,.celebrate h2 em{font-style:italic;color:var(--cross)}
.strip-row{overflow:hidden;margin-bottom:18px}
.strip-track{display:flex;align-items:center;gap:18px;width:max-content;animation:marquee 140s linear infinite}
.strip-row.rev .strip-track{animation-direction:reverse;animation-duration:160s}
.strip-row:hover .strip-track{animation-play-state:paused}
.strip figure{margin:0;width:clamp(200px,24vw,300px);aspect-ratio:1;border-radius:22px;overflow:hidden;flex:0 0 auto}
.strip-row.rev figure{aspect-ratio:4/3;width:clamp(220px,26vw,340px)}
.strip figure img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .8s}
.strip figure:hover img{transform:scale(1.07)}
.doodle{flex:0 0 auto;width:74px;height:74px;border-radius:50%;background:#fff var(--ging-sm) repeat;display:grid;place-items:center;box-shadow:0 0 0 4px #fff}
.doodle svg{width:70%;background:#fff;border-radius:50%;padding:8%}
@media (prefers-reduced-motion:reduce){.strip-track,.sticker{animation:none}}

/* Celebrate banner */
.celebrate{position:relative;min-height:clamp(520px,70vw,720px);display:grid;place-items:center;overflow:hidden;margin:clamp(40px,6vw,80px) 0}
.celebrate-img{position:absolute;inset:-12% 0}
.celebrate-img img{width:100%;height:100%;object-fit:cover;display:block}
.celebrate-img::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(91,53,32,.15),rgba(91,53,32,.45))}
.celebrate-card{position:relative;max-width:560px;margin:0 20px;text-align:center;padding:clamp(30px,5vw,50px)}
.celebrate-card .k{display:block}
.celebrate h2{font-size:clamp(2.2rem,5.5vw,3.6rem);margin:10px 0 12px}
.celebrate h2 em{color:var(--coral)}
.celebrate p{color:var(--muted);margin:0 0 22px}

@supports (animation-timeline:view()){
  @media (prefers-reduced-motion:no-preference){
    @keyframes archzoom{from{transform:scale(1.25)}to{transform:scale(1.02)}}
    .arch img{animation:archzoom linear both;animation-timeline:view();animation-range:cover 0% cover 100%}
    @keyframes heroout{to{transform:translateY(-60px);opacity:.4}}
    .hero2-photo{animation:heroout linear both;animation-timeline:view();animation-range:exit 0% exit 100%}

    @keyframes featin{from{opacity:0;transform:translateY(90px) rotate(2deg)}to{opacity:1;transform:none}}
    .feat{animation:featin linear both;animation-timeline:view();animation-range:entry 0% entry 70%}
    .feat:nth-child(2){animation-range:entry 10% entry 85%}
    .feat:nth-child(3){animation-range:entry 20% entry 100%}

    @keyframes bigtitle{from{opacity:0;transform:scale(.85);letter-spacing:.06em}to{opacity:1;transform:none;letter-spacing:normal}}
    .strip-title,.feat-head h2{animation:bigtitle linear both;animation-timeline:view();animation-range:entry 10% cover 40%}

    @keyframes celebpar{from{transform:translateY(-8%)}to{transform:translateY(8%)}}
    .celebrate-img{animation:celebpar linear both;animation-timeline:view();animation-range:cover 0% cover 100%}
    .celebrate-card{animation:reveal linear both;animation-timeline:view();animation-range:entry 20% cover 50%}
  }
}
@media (prefers-reduced-motion:no-preference){.hero2-photo .arch{animation:rise 1.1s .3s cubic-bezier(.2,.8,.2,1) both}.hero2 .sticker{animation:pop .8s 1s cubic-bezier(.3,1.4,.4,1) both,sway 9s 1.8s ease-in-out infinite}}

/* New G&C scalloped badge logo */
.label-art{background:transparent;border:0;box-shadow:none;overflow:visible}
.label-art img{object-fit:contain;filter:drop-shadow(0 10px 18px rgba(91,53,32,.22))}
.logo img{box-shadow:none;border-radius:0}

    <form action="https://formspree.io/f/{{ s.formspree_id }}" method="POST">
      <input type="hidden" name="_subject" value="New {{ s.business_name }} order">
      <fieldset>
        <legend>Your details</legend>
        <div class="field"><label for="name">Full name</label><input id="name" name="Name" type="text" autocomplete="name" required></div>
        <div class="field"><label for="phone">Phone number <span class="hint">(for texting about your order)</span></label><input id="phone" name="Phone" type="tel" autocomplete="tel" required></div>
        <div class="field full"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required></div>
      </fieldset>
      <fieldset>
        <legend>Your order</legend>
        <div class="field full">
          <span class="label-t" id="what-label">1. Pick your treats <span class="hint">(tick as many as you like)</span></span>
          <div class="pick" role="group" aria-labelledby="what-label">
            {% for g in menu.groups %}{% set any = false %}{% for it in g.items %}{% if it.available %}{% set any = true %}{% endif %}{% endfor %}{% if any %}
            <div class="pick-group">
              <p class="pick-h">{{ g.title }}</p>
              <div class="pick-list">
              {% for it in g.items %}{% if it.available %}
                <label class="pick-item"><input type="checkbox" id="pk-{{ it.name | slugify }}" name="Items" value="{{ it.name }}"><span>{{ it.name }}</span></label>
              {% endif %}{% endfor %}
              </div>
            </div>
            {% endif %}{% endfor %}
            {% if holiday.show and holiday.add_to_order_form and holiday.claimed < holiday.total %}
            <div class="pick-group"><p class="pick-h">Holiday</p><div class="pick-list"><label class="pick-item"><input type="checkbox" id="pk-{{ holiday.title | slugify }}" name="Items" value="{{ holiday.title }}"><span>{{ holiday.title }}</span></label></div></div>
            {% endif %}
          </div>
        </div>
        <div class="field full">
          <span class="label-t" id="amt-label">2. How many, and which flavours?</span>
          <div class="basket" role="group" aria-labelledby="amt-label">
            <p class="basket-empty">Tick a treat above and it will appear here so you can add the quantity and flavour.</p>
            {% set picked = [] %}
            {% for g in menu.groups %}{% for it in g.items %}{% if it.available %}{% set picked = (picked.push(it.name), picked) %}{% endif %}{% endfor %}{% endfor %}
            {% if holiday.show and holiday.add_to_order_form and holiday.claimed < holiday.total %}{% set picked = (picked.push(holiday.title), picked) %}{% endif %}
            {% for n in picked %}{% set sid = n | slugify %}
            {% if n == holiday.title %}
            <div class="basket-row basket-box br-{{ sid }}">
              <p class="basket-name">{{ n }}</p>
              <label><span class="sr">{{ n }} number of boxes</span><input type="text" name="{{ n }}: number of boxes" placeholder="How many boxes?" autocomplete="off"></label>
              <div class="box-picks">
                <p class="box-picks-h">Pick the cookies for your box <span class="hint">(up to 6 flavours)</span></p>
                {% for i in range(1, 7) %}
                <label><span class="sr">Cookie choice {{ i }}</span><select name="{{ n }}: cookie {{ i }}">
                  <option value="">Cookie {{ i }}</option>
                  {% for g in menu.groups %}{% if g.title == "Cookies" or g.title == "Italian cookies" %}{% for c in g.items %}{% if c.available %}<option>{{ c.name }}</option>{% endif %}{% endfor %}{% endif %}{% endfor %}
                  <option>Baker's choice</option>
                </select></label>
                {% endfor %}
              </div>
            </div>
            {% else %}
            <div class="basket-row br-{{ sid }}">
              <p class="basket-name">{{ n }}</p>
              <label><span class="sr">{{ n }} quantity</span><input type="text" name="{{ n }}: quantity" placeholder="Qty, e.g. 2 dozen" aria-describedby="amt-label" autocomplete="off"></label>
              <label><span class="sr">{{ n }} flavour</span><input type="text" name="{{ n }}: flavour" placeholder="Flavour (optional)" autocomplete="off"></label>
            </div>
            {% endif %}
            {% endfor %}
          </div>
          <style>
            @supports selector(:has(*)){
              .basket-row{display:none}
              {% for n in picked %}{% set sid = n | slugify %}form:has(#pk-{{ sid }}:checked) .br-{{ sid }}{display:grid}
              {% endfor %}
              form:has(.pick input:checked) .basket-empty{display:none}
            }
          </style>
        </div>
        <div class="field"><label for="occasion">Occasion</label>
          <select id="occasion" name="Occasion">
            <option value="">Choose one (optional)</option>
            <option>Birthday</option><option>Baby or bridal shower</option><option>Holiday</option><option>Gift</option><option>Just because</option><option>Other</option>
          </select>
        </div>
        <div class="field full"><label for="design">Design details <span class="hint">(colours, theme, packaging, gift notes, inspiration links; you can also DM photos to @{{ s.instagram }})</span></label><textarea id="design" name="Design details"></textarea></div>
        <div class="field"><label for="promo">Promo code <span class="hint">(optional)</span></label><input id="promo" name="Promo code" type="text" autocomplete="off"></div>
        <div class="field full"><label for="allergies">Allergies or dietary needs <span class="hint">(write "None" if none)</span></label><input id="allergies" name="Allergies" type="text" required></div>
      </fieldset>
      <fieldset>
        <legend>Pickup &amp; payment</legend>
        <div class="field"><label for="date">Pickup date</label><input id="date" name="Pickup date" type="date" required></div>
        <div class="field"><label for="time">Pickup time</label>
          <select id="time" name="Pickup time" required>
            <option value="">Choose a time</option>
            {% for t in s.pickup_times %}<option>{{ t }}</option>{% endfor %}
          </select>
        </div>
        <div class="field"><label for="pay">How will you pay?</label>
          <select id="pay" name="Payment" required>
            <option value="">Choose one</option>
            <option>Interac e-Transfer</option><option>Cash at pickup (balance only)</option>
          </select>
        </div>
        <div class="field"><label for="heard">How did you hear about us?</label>
          <select id="heard" name="Heard about us">
            <option value="">Choose one (optional)</option>
            <option>Instagram</option><option>Friend or family</option><option>Market or event</option><option>Facebook</option><option>Google</option>
          </select>
        </div>
        <div class="field full">
          <label class="agree" for="terms"><input id="terms" name="Agreed to terms" type="checkbox" value="Yes" required> I understand custom orders need a 50% non-refundable deposit to book, other orders are paid in full when booked, and everything is made in a home kitchen that handles nuts, dairy, eggs, wheat and soy.</label>
        </div>
      </fieldset>
      <div class="submit-row">
        <button class="btn" type="submit">Request my spot</button>
        <p>I'll text you within 24 hours to confirm. Questions? {% if s.email %}Email <a href="mailto:{{ s.email }}">{{ s.email }}</a> or {% endif %}DM <a href="https://www.instagram.com/{{ s.instagram }}/">@{{ s.instagram }}</a> on Instagram.</p>
      </div>
    </form>

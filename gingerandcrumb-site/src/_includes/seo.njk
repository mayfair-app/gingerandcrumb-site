<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ s.business_name }} | Home Bakery in {{ loc }}</title>
<meta name="description" content="{{ s.business_name }} is a small-batch home bakery in {{ loc }}. Cookies, cupcakes, custom cakes and loaves, baked from scratch to order. Pickup only.">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Bakery",
  "name": {{ s.business_name | dump | safe }},
  "description": "Small-batch home bakery. Cookies, cupcakes, custom cakes and loaves baked from scratch to order.",
  "address": {"@type": "PostalAddress", "addressLocality": {{ s.city | dump | safe }}, "addressRegion": "ON", "addressCountry": "CA"},
  "areaServed": {{ s.service_areas | dump | safe }},
  "servesCuisine": "Baked goods",
  {% if s.site_url %}"url": {{ s.site_url | dump | safe }},{% endif %}
  {% if s.email %}"email": {{ s.email | dump | safe }},{% endif %}
  "sameAs": ["https://www.instagram.com/{{ s.instagram }}/"]
}
</script>
